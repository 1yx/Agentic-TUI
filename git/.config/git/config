# ~/.config/git/config — generic/shared, committed & stow-managed.
#
# Git reads global config in this order (later files win per-key):
#   1. /etc/gitconfig        (system)
#   2. ~/.config/git/config  (XDG global  ← this file, via stow)
#   3. ~/.gitconfig          (HOME global ← personal / sensitive)
#   4. .git/config           (repo local)
#
# Personal identity (name/email), signing keys, gpg paths, proxy, and your
# preferred editor belong in ~/.gitconfig — a real file OUTSIDE the repo, never
# committed. It overrides anything in this file.
# See AGENTS.md §4 "Git Identity Setup".

[core]
    editor = emacsclient -t

[init]
    defaultBranch = main
[alias]
	lg = log --graph --pretty=format:'%C(auto)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr)%Creset' --all --exclude=refs/pi-checkpoints/* --exclude=refs/cmux/*
	st = status -sb
	br = branch -vv
	cm = commit -m
	outgoing = log @{u}..HEAD
	incoming = log HEAD..@{u}
	wdiff = diff -w --word-diff=color --ignore-space-at-eol
[push]
	default = current
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[url "https://"]
	insteadOf = git://
